local function getNearestTarget()
    local nearestDistance = math.huge
    local nearestTarget = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local myPos = localPlayer.Character.HumanoidRootPart.Position
                    local targetPos = player.Character.Head.Position
                    local distance = (myPos - targetPos).Magnitude
                    
                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearestTarget = player.Character.Head
                    end
                end
            end
        end
    end
    return nearestTarget
end

local function applyESP()
    local espColor = rampageActive and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(0, 150, 0)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local highlight = player.Character:FindFirstChild("AimBoy_Highlight")
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "AimBoy_Highlight"
                highlight.FillTransparency = 0.6
                highlight.OutlineTransparency = 0.1
                highlight.Parent = player.Character
            end
            highlight.FillColor = espColor
            highlight.OutlineColor = espColor
        end
    end
end

local function clearESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local highlight = player.Character:FindFirstChild("AimBoy_Highlight")
            if highlight then highlight:Destroy() end
        end
    end
end

-- ==========================================
-- 5. RUNTIME CONNECTIONS
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseButton2 then
        aimbotActive = not aimbotActive
        circleFrame.Visible = aimbotActive
        
        if aimbotActive then
            statusLabel.Text = "Aim: TRACKING"
            statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
            applyESP()
        else
            statusLabel.Text = "Aim: OFF (Right-Click)"
            statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            healthLabel.Text = "Target HP: N/A"
            healthBarFill.Size = UDim2.new(0, 0, 1, 0)
            clearESP()
        end
    end
end)

RunService.RenderStepped:Connect(function(deltaTime)
    if aimbotActive then
        local spinSpeed = rampageActive and 400 or 150
        circleGradient.Rotation = (circleGradient.Rotation + spinSpeed * deltaTime) % 360
        
        applyESP()
        
        local target = getNearestTarget()
        if target then
            local targetHumanoid = target.Parent:FindFirstChild("Humanoid")
            if targetHumanoid then
                local hp = math.max(0, targetHumanoid.Health)
                local maxHp = targetHumanoid.MaxHealth
                local hpPercent = hp / maxHp
                
                healthLabel.Text = "Target HP: " .. math.floor(hp) .. " / " .. math.floor(maxHp)
                healthBarFill.Size = UDim2.new(hpPercent, 0, 1, 0)
            end

            local smoothFactor = rampageActive and 0.85 or 0.15
            local goalCFrame = CFrame.new(camera.CFrame.Position, target.Position)
            camera.CFrame = camera.CFrame:Lerp(goalCFrame, smoothFactor)
        else
            healthLabel.Text = "Target HP: N/A"
            healthBarFill.Size = UDim2.new(0, 0, 1, 0)
        end
    end
end)

